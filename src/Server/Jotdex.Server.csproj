<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Core\Jotdex.Core.csproj" />
    <ProjectReference Include="..\Infrastructure\Jotdex.Infrastructure.csproj" />
    <ProjectReference Include="..\PowerShellDiagnostics\Jotdex.PowerShellDiagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.8" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.3.3</Version>
    <AssemblyVersion>1.3.3.0</AssemblyVersion>
    <FileVersion>1.3.3.0</FileVersion>
    <InformationalVersion>1.3.3</InformationalVersion>
  </PropertyGroup>

  <!-- When PSScriptAnalyzer is installed (scripts/install-psscriptanalyzer.ps1 or publish), copy beside the exe. -->
  <ItemGroup Condition="Exists('..\PowerShellDiagnostics\modules\PSScriptAnalyzer')">
    <Content Include="..\PowerShellDiagnostics\modules\PSScriptAnalyzer\**\*">
      <Link>modules\PSScriptAnalyzer\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
